{
  "apps": [
    {
      "name": "mastra-studio",
      "script": ".mastra/output/index.mjs",
      "node_args": "--env-file=.env",
      "env": {
        "MASTRA_STUDIO_PATH": ".mastra/output/studio"
      }
    },
    {
      "name": "awas-mastra-build",
      "script": "node",
      "args": ".mastra/output/index.mjs",
      "cwd": ".",
      "autorestart": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production",
        "NODE_OPTIONS": "--max-old-space-size=2048",
        "MASTRA_STUDIO_PATH": ".mastra/output/studio",
        "MONGODB_URI": "mongodb+srv://backend-agents:Ct1GtVObDZ3UpL0r@awas.ieqeep7.mongodb.net/",
        "MONGODB_DATABASE": "mastra"
      },
      "env_production": {
        "NODE_ENV": "production",
        "NODE_OPTIONS": "--max-old-space-size=2048",
        "MASTRA_STUDIO_PATH": ".mastra/output/studio",
        "MONGODB_URI": "mongodb+srv://backend-agents:Ct1GtVObDZ3UpL0r@awas.ieqeep7.mongodb.net/",
        "MONGODB_DATABASE": "mastra"
      },
      "error_file": "./logs/build-error.log",
      "out_file": "./logs/build-out.log",
      "merge_logs": true
    }
  ],
  "deploy": {
    "production": {
      "user": "ec2-user",
      "host": "ec2-65-1-131-37.ap-south-1.compute.amazonaws.com",
      "ref": "origin/main",
      "repo": "git@github.com:YOUR_REPO.git",
      "path": "/home/ec2-user/awas-ai-agents",
      "post-deploy": "npm install && npm run build && pm2 startOrRestart process.json --env production"
    }
  }
}