# =============================================================================
# AWAS AI Agent Repository (.env.example)
# Copy to .env and fill in your credentials. Never commit real secrets here.
# =============================================================================

# Primary Execution & Provider Routing ('auto' | 'gemini' | 'groq' | 'openai' | 'lm-studio' | 'ollama')
DEFAULT_PROVIDER=auto
DEFAULT_EXECUTION_MODE=auto

# Cloud LLM Providers
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=google/gemini-3.8-flash

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Local Inference Daemons (Zero-Data-Leak Local Mode)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio-local
LM_STUDIO_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Centralized Model Profile Overrides (Optional)
# PROFILE_CREATIVE_CLOUD_MODEL=google/gemini-3.8-flash
# PROFILE_ANALYTICAL_CLOUD_MODEL=google/gemini-3.8-flash
# PROFILE_FAST_CLOUD_MODEL=llama-3.3-70b-versatile
# PROFILE_RESEARCH_CLOUD_MODEL=google/gemini-3.8-flash
# PROFILE_SUPERVISOR_CLOUD_MODEL=google/gemini-3.8-flash
# PROFILE_COMPLIANCE_CLOUD_MODEL=google/gemini-3.8-flash

# Storage Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/mastra
MONGODB_DATABASE=mastra

# External Tool Integrations (Optional — sandbox fallbacks active when omitted)
EXA_API_KEY=your-exa-api-key-here
GITHUB_TOKEN=your-github-token-here
YOUTUBE_API_KEY=your-youtube-api-key-here
SLACK_BOT_TOKEN=your-slack-bot-token-here
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key-here
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

# Server & Telemetry Settings
HOST=127.0.0.1
PORT=4111
LOG_LEVEL=info
MASTRA_PACKAGES_FILE=../mastra-packages.json
